# Web client: Renderなどへ配置したシグナリングURL。ローカルでは未指定で ws://<host>:8787/signal。
VITE_SIGNAL_URL=wss://your-signal-service.onrender.com/signal
# TURNを使う場合だけ設定。認証情報を固定でコミットしないこと。
# VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]
VITE_ICE_SERVERS_JSON=[]
# 開発用。npm run dev:debug または Vite mode debug と併用可能。
VITE_DEBUG_START_LEVEL=0

# Signaling server (Render は PORT を自動設定)
SIGNAL_PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
